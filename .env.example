# =============================================================================
# Server-Side Environment Variables (Configure in Vercel or Render Settings)
# NEVER commit real API keys or secrets to Git!
# =============================================================================

# OpenAI API Key (Required for Multimodal AI Machine Inspection with GPT-4o)
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Default OpenAI vision model (defaults to gpt-4o)
OPENAI_VISION_MODEL=gpt-4o

# Optional: Google Gemini API Key (fallback if configured)
GEMINI_API_KEY=your_gemini_api_key_here

# Port for local Node.js backend server
PORT=5000
