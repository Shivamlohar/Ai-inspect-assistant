# =============================================================================
# Server-Side Environment Variables (Configure in Vercel or Render Settings)
# NEVER commit real API keys or secrets to Git!
# =============================================================================

# Google Gemini API Key (Required for Multimodal AI Machine Inspection)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Gemini vision model (defaults to gemini-2.5-flash)
GEMINI_VISION_MODEL=gemini-2.5-flash

# Optional: OpenAI API Key (for GPT-4o vision fallback if preferred)
OPENAI_API_KEY=your_openai_api_key_here

# Port for local Node.js backend server
PORT=5000
